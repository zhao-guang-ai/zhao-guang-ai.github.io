---
import type { Service } from '../data/services';
import { href, UI, type Lang } from '../data/site';

interface Props {
  service: Service;
  lang: Lang;
  /** 列表页里每个卡片是一级章节，用 h2；首页嵌在「服务」小节里，用 h3（默认） */
  as?: 'h2' | 'h3';
}

const { service, lang, as: Heading = 'h3' } = Astro.props;
---

<article class="card reveal">
  <div class="card__index">{service.index}</div>
  <Heading class="card__title">
    <a href={href(lang, `/services/${service.slug}`)}>{service.name[lang]}</a>
  </Heading>
  <div class="card__body">
    <p>{service.tagline[lang]}</p>
    <div class="tags">
      {service.tags[lang].map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
  <div class="card__foot">
    <a class="text-link" href={href(lang, `/services/${service.slug}`)}>
      {UI.readMore[lang]} →
    </a>
  </div>
</article>
