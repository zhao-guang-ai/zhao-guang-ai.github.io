---
/**
 * 所有 SEO 相关的 <head> 内容都在这里。
 * 每页只需传 title / description / lang / path，其余自动处理：
 *   canonical、hreflang 双语互指、Open Graph、Twitter Card、结构化数据。
 */
import { SITE, href, type Lang } from '../data/site';

interface Props {
  /** 页面标题（不含品牌后缀，会自动补） */
  title: string;
  description: string;
  lang: Lang;
  /** 语言无关的路径，例如 '/services/fractional-cmo' */
  path: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  /** 额外的 JSON-LD 结构化数据 */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * 另一种语言是否存在对应页面。
   * 内容页如果只有单语版本（比如只写了英文文章），必须传 false，
   * 否则 hreflang 会指向一个 404，反而损害 SEO。
   */
  hasTranslation?: boolean;
}

const {
  title,
  description,
  lang,
  path,
  type = 'website',
  image = SITE.ogImage,
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  hasTranslation = true,
} = Astro.props;

/** 估算搜索结果里的显示宽度：中日韩字符按 2 个单位计 */
function displayWidth(text: string): number {
  let width = 0;
  for (const char of text) {
    width += /[\u3000-\u9fff\uff00-\uffef]/.test(char) ? 2 : 1;
  }
  return width;
}

// 标题里已经有品牌名就不再重复追加。
// Google 大约 60 个宽度单位就会截断标题，所以当加上品牌名会把关键信息挤出去时，
// 宁可不要品牌后缀，也要保住标题本身的完整。
const BRAND_SUFFIX = ' | Xiaoli';
const MAX_TITLE_WIDTH = 64;
const fullTitle = title.includes('Xiaoli')
  ? title
  : displayWidth(`${title}${BRAND_SUFFIX}`) <= MAX_TITLE_WIDTH
    ? `${title}${BRAND_SUFFIX}`
    : title;

const canonical = new URL(href(lang, path), SITE.url).href;
const urlEn = new URL(href('en', path), SITE.url).href;
const urlZh = new URL(href('zh', path), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// 只输出真实存在的语言版本，避免 hreflang 指向 404
const alternates: { hreflang: string; href: string }[] = [];
if (lang === 'en') {
  alternates.push({ hreflang: 'en-SG', href: urlEn });
  if (hasTranslation) alternates.push({ hreflang: 'zh-CN', href: urlZh });
} else {
  if (hasTranslation) alternates.push({ hreflang: 'en-SG', href: urlEn });
  alternates.push({ hreflang: 'zh-CN', href: urlZh });
}
// x-default 指向默认语言；若只有中文版，就指向中文版
const xDefault = lang === 'zh' && !hasTranslation ? urlZh : urlEn;

// 站点级结构化数据：让 Google 知道「Xiaoli 是一个真实的人，这是她的官网」
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.name.en,
  alternateName: SITE.name.zh,
  jobTitle: SITE.role.en,
  description:
    'Fractional CMO for EduTech companies in Singapore and Southeast Asia.',
  url: SITE.url,
  image: ogImage,
  email: `mailto:${SITE.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Singapore',
    addressCountry: 'SG',
  },
  knowsAbout: [
    'EduTech marketing',
    'Go-to-market strategy',
    'Demand generation',
    'B2B SaaS marketing',
    'Fractional CMO services',
  ],
  sameAs: [SITE.linkedin, SITE.x].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: `${SITE.name.en} — ${SITE.role.en}`,
  inLanguage: ['en-SG', 'zh-CN'],
  publisher: { '@id': `${SITE.url}/#person` },
};

const schemas = [personSchema, websiteSchema, ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* 告诉 Google 中英两版是同一个页面的不同语言，避免判成重复内容。
    noindex 页面（如 404）不输出 alternates —— 它们本来就不该被索引。 */}
{
  !noindex && (
    <>
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={xDefault} />
    </>
  )
}

{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.shortName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_SG'} />
<meta property="og:locale:alternate" content={lang === 'zh' ? 'en_SG' : 'zh_CN'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content="#0f6f6c" />

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
