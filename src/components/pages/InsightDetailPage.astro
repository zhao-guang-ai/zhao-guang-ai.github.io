---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../Cta.astro';
import { SITE, UI, href, altHref, type Lang } from '../../data/site';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      tags: string[];
    };
  };
  lang: Lang;
  /** 另一种语言是否有同一篇文章 */
  hasTranslation?: boolean;
}

const { post, lang, hasTranslation = true } = Astro.props;
const isEn = lang === 'en';
const { Content } = await render(post as never);
const slug = post.id.split('/').pop();

const dateLabel = new Intl.DateTimeFormat(isEn ? 'en-SG' : 'zh-CN', {
  dateStyle: 'long',
}).format(post.data.pubDate);

const canonical = new URL(href(lang, `/insights/${slug}`), SITE.url).href;

// 文章结构化数据：让 Google 知道作者是谁、何时发布，有利于 E-E-A-T
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: isEn ? 'en-SG' : 'zh-CN',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@id': `${SITE.url}/#person` },
  publisher: { '@id': `${SITE.url}/#person` },
  keywords: post.data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: isEn ? 'Home' : '首页',
      item: isEn ? SITE.url : `${SITE.url}/zh/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: isEn ? 'Insights' : '洞察文章',
      item: new URL(href(lang, '/insights'), SITE.url).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  path={`/insights/${slug}`}
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  hasTranslation={hasTranslation}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article>
    <header class="page-hero">
      <div class="container container--narrow">
        <p class="eyebrow">{isEn ? 'Insight' : '洞察'}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <div class="page-hero__meta">
          <span>{dateLabel}</span>
          <span>{SITE.name[lang]}</span>
        </div>
      </div>
    </header>

    <div class="section">
      <div class="container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {
      post.data.tags.length > 0 && (
        <div class="container container--narrow">
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      )
    }

    <div class="container container--narrow" style="margin-top:3rem;">
      <hr class="rule" />
      <div class="btn-row" style="margin-top:1.5rem;justify-content:space-between;">
        <a class="text-link" href={href(lang, '/insights')}>← {UI.allInsights[lang]}</a>
        {
          hasTranslation && (
            <a
              class="text-link"
              href={altHref(lang, `/insights/${slug}`)}
              hreflang={lang === 'en' ? 'zh-CN' : 'en-SG'}
            >
              {lang === 'en' ? '阅读中文版 →' : 'Read in English →'}
            </a>
          )
        }
      </div>
    </div>
  </article>

  <Cta lang={lang} />
</BaseLayout>
