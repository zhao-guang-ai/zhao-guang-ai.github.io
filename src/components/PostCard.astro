---
import { href, UI, type Lang } from '../data/site';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
    };
  };
  lang: Lang;
}

const { post, lang } = Astro.props;
const slug = post.id.split('/').pop();
const dateLabel = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-SG', {
  dateStyle: 'medium',
}).format(post.data.pubDate);
---

<article class="card reveal">
  <div class="post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
  </div>
  <h3 class="card__title">
    <a href={href(lang, `/insights/${slug}`)}>{post.data.title}</a>
  </h3>
  <div class="card__body">
    <p>{post.data.description}</p>
  </div>
  <div class="card__foot">
    <a class="text-link" href={href(lang, `/insights/${slug}`)}>
      {UI.readMore[lang]} →
    </a>
  </div>
</article>
