---
import { getCollection } from 'astro:content';
import InsightDetailPage from '../../components/pages/InsightDetailPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<InsightDetailPage post={post} lang="en" />
